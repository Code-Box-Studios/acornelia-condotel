APP_ENV=development
APP_URL=http://localhost:3042
APP_OPERATION_MODE=quarantine
# pnpm local:setup generates protected local values without overwriting .env.
LOCAL_DATABASE_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
PAYLOAD_SECRET=
PROPERTY_TIMEZONE=Asia/Manila
MAYA_ENVIRONMENT=sandbox
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_PUBLIC_KEYS=
BOOKING_CONFIRMATION_CC=codeboxstudios.official@gmail.com
EMAIL_FROM=
EMAIL_FROM_NAME=Acornelia
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
WORK_RUNNER_SECRET=
# Only local development may enable synthetic room/rate/content fixtures.
DEVELOPMENT_FIXTURES=false

# Customer email/password is a local candidate; production remains disabled until selected.
CUSTOMER_AUTH_METHOD=
EMAIL_TRANSPORT=
# First local operator only; existing staff are never promoted or replaced.
BOOTSTRAP_ADMIN_EMAIL=codeboxstudios.official@gmail.com
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Enable only after production acceptance; previews remain noindex.
INDEX_PUBLIC_SITE=false

# Two current, distinct Maya RSA public keys, pinned to this environment.
MAYA_WEBHOOK_KEY_ENVIRONMENT=
MAYA_WEBHOOK_PUBLIC_KEY_1=
MAYA_WEBHOOK_PUBLIC_KEY_2=
# Milliseconds, 1000 through 300000. Default follows the documented five-minute example.
MAYA_WEBHOOK_TOLERANCE_MS=300000
